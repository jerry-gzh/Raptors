---
import { getCollection } from "astro:content";
import RaptorsConfig from "../../raptors.config";
import { GetCarouselImages } from "../utils/assets";
import { GetCoverURLForUnspecifiedEntry } from "../utils/cover";
import { IdToSlug } from "../utils/hash";

export interface Props {
  title?: string;
  subTitle?: string;
  bannerImage?: string;
  slug?: string;
}
const { title, subTitle, bannerImage, slug } = Astro.props;

const hasTitle = title !== undefined || subTitle !== undefined;
const hasHeaderImg = bannerImage !== undefined || slug !== undefined;
const anniversaryEntry = (await getCollection("posts")).find(
  (entry) => entry.data.title === "3° Aniversario Raptors",
);
const anniversaryPath = anniversaryEntry
  ? `/posts/${IdToSlug(anniversaryEntry.id.toLowerCase())}`
  : "/";
const heroBadges = (RaptorsConfig.heroBadges ?? []).filter((badge) => {
  if (hasTitle) return true;
  return badge !== "3er Aniversario" && badge !== "Domingo 31 de mayo de 2026";
});

let carouselImgsList = GetCarouselImages();
const carouselAnimationTime = `${carouselImgsList.length * 6}s`;
---

<div id="banner" class="banner onload-animation-fade-in">
  <div class="transition-main banner-inner h-full w-full">
    {
      !hasHeaderImg && (
        <div class="carousel">
          <ul id="carousel_imgs">
            {carouselImgsList.map((img, index) => (
              <li
                class="item lozad"
                style={{ animationDelay: `${index * 6}s` }}
                data-background-image={img}
              />
            ))}
          </ul>
        </div>
      )
    }
    {
      hasHeaderImg && (
        <div class="cover">
          <img
            class="item lozad"
            data-src={bannerImage ?? GetCoverURLForUnspecifiedEntry(slug ?? "")}
            alt="PostCoverr"
          />
        </div>
      )
    }
    <div class="relative h-[95%] w-full">
      <div
        class="absolute left-1/2 top-[58%] w-[92%] -translate-x-1/2 -translate-y-1/2 sm:top-[55%] sm:w-[88%] lg:top-1/2 lg:w-3/4"
      >
        {
          !hasHeaderImg ? (
            <a href={anniversaryPath} class="hero-link">
              <div class="hero-copy soft-float flex flex-col">
                <div class="hero-kicker-wrap">
                  <span class="hero-kicker">
                    {RaptorsConfig.heroLabel ?? "Raptors Morelia"}
                  </span>
                </div>
                <h1
                  class:list={[hasTitle ? "title-normal" : "title-index"]}
                  class="title"
                >
                  {title ?? RaptorsConfig.title}
                </h1>
                <h2 class="subtitle">{subTitle ?? RaptorsConfig.subTitle}</h2>
                {
                  heroBadges.length > 0 && (
                    <div class="hero-badges">
                      {heroBadges.map((badge) => (
                        <span class="hero-badge">{badge}</span>
                      ))}
                    </div>
                  )
                }
              </div>
            </a>
          ) : (
            <div class="hero-copy soft-float flex flex-col">
              <div class="hero-kicker-wrap">
                <span class="hero-kicker">
                  {RaptorsConfig.heroLabel ?? "Raptors Morelia"}
                </span>
              </div>
              <h1
                class:list={[hasTitle ? "title-normal" : "title-index"]}
                class="title"
              >
                {title ?? RaptorsConfig.title}
              </h1>
              <h2 class="subtitle">{subTitle ?? RaptorsConfig.subTitle}</h2>
              {
                heroBadges.length > 0 && (
                  <div class="hero-badges">
                    {heroBadges.map((badge) => (
                      <span class="hero-badge">{badge}</span>
                    ))}
                  </div>
                )
              }
            </div>
          )
        }
      </div>
    </div>
  </div>
  <div class="waves" id="header-waves">
    <svg
      class="waves"
      xmlns="http://www.w3.org/2000/svg"
      xmlns:xlink="http://www.w3.org/1999/xlink"
      viewBox="0 24 150 28"
      preserveAspectRatio="none"
      shape-rendering="auto"
    >
      <defs>
        <path
          id="gentle-wave"
          d="M-160 44c30 0 58-18 88-18s 58 18 88 18 58-18 88-18 58 18 88 18 v44h-352z"
        >
        </path>
      </defs>
      <g class="parallax">
        <use
          xlink:href="#gentle-wave"
          x="48"
          y="0"
          class="opacity-25"
          style={{ animationDelay: "-2s", animationDuration: "7s" }}></use>
        <use
          xlink:href="#gentle-wave"
          x="48"
          y="3"
          class="opacity-50"
          style={{ animationDelay: "-3s", animationDuration: "10s" }}></use>
        <use
          xlink:href="#gentle-wave"
          x="48"
          y="5"
          class="opacity-75"
          style={{ animationDelay: "-4s", animationDuration: "13s" }}></use>
        <use
          xlink:href="#gentle-wave"
          x="48"
          y="7"
          style={{ animationDelay: "-5s", animationDuration: "20s" }}></use>
      </g>
    </svg>
  </div>
</div>

<script>
  const styleElement = document.createElement("style");
  const carouselImgs = document.getElementById("carousel_imgs");
  const carouselImgsCount = carouselImgs?.children.length ?? 0;

  const carouselAnimation = `
  @keyframes carousel-animation {
    0% {
      opacity: 0;
      transform: scale(1);
    }
    3% {
      opacity: 1;
    }
    8% {
      opacity: 1;
      animation-timing-function: ease-out;
    }
    ${100 / carouselImgsCount}% {
      opacity: 1;
    }
    ${100 / carouselImgsCount + 50 / carouselImgsCount}% {
      opacity: 0;
      animation-timing-function: ease-out;
    }
    100% {
      opacity: 0;
      transform: scale(2);
    }
  }
  `;
  styleElement.textContent = carouselAnimation;
  let bannerElement = document.getElementById("banner");
  if (bannerElement && !bannerElement.querySelector("style"))
    bannerElement.appendChild(styleElement);
</script>

<style define:vars={{ carouselAnimationTime }}>
  .banner {
    @apply relative opacity-100 lg:h-[var(--banner-height)];
    height: clamp(31rem, 74vh, 38rem);
  }

  .carousel {
    @apply absolute left-0 top-0 -z-10 block w-full overflow-hidden bg-black lg:h-[var(--banner-height)];
    height: clamp(31rem, 74vh, 38rem);
    animation-fill-mode: forwards;
  }

  .carousel::before {
    @apply absolute left-0 top-0 z-10 block h-full w-full transition-all content-[''];
    background:
      linear-gradient(135deg, rgba(10, 10, 10, 0.82), rgba(10, 10, 10, 0.28)),
      radial-gradient(circle at 18% 20%, rgba(255, 133, 24, 0.42), transparent 34%),
      linear-gradient(180deg, rgba(10, 10, 10, 0.08), rgba(10, 10, 10, 0.7));
  }

  .carousel .item {
    @apply absolute left-0 top-0 z-0 h-full w-full origin-center bg-cover bg-center bg-no-repeat opacity-0;
    animation: carousel-animation var(--carouselAnimationTime) linear infinite
      0s;
    backface-visibility: hidden;
    transform-style: preserve-3d;
    filter: contrast(1.12) saturate(1.04);
  }

  .cover {
    @apply absolute left-0 top-0 z-0 block w-full overflow-hidden bg-black lg:h-[var(--banner-height)];
    height: clamp(31rem, 74vh, 38rem);
  }

  .cover::before {
    @apply absolute left-0 top-0 z-10 block h-full w-full transition-all content-[''];
    background:
      linear-gradient(135deg, rgba(10, 10, 10, 0.82), rgba(10, 10, 10, 0.28)),
      radial-gradient(circle at 18% 20%, rgba(255, 133, 24, 0.42), transparent 34%),
      linear-gradient(180deg, rgba(10, 10, 10, 0.08), rgba(10, 10, 10, 0.7));
  }

  .cover .item {
    @apply h-full w-full object-cover;
  }

  .hero-copy {
    @apply mx-auto max-w-4xl rounded-[1.75rem] border border-white/15 px-5 py-6 backdrop-blur-md sm:px-6 sm:py-8 lg:rounded-[2.25rem] lg:px-10 lg:py-10;
    background:
      linear-gradient(145deg, rgba(15, 15, 15, 0.76), rgba(15, 15, 15, 0.38)),
      radial-gradient(circle at top left, rgba(255, 133, 24, 0.24), transparent 38%);
    box-shadow: 0 30px 80px -44px rgba(0, 0, 0, 0.85);
    position: relative;
    overflow: hidden;
  }

  .hero-link {
    @apply block rounded-[1.75rem] no-underline outline-none lg:rounded-[2.25rem];
  }

  .hero-link:hover .hero-copy,
  .hero-link:focus-visible .hero-copy {
    border-color: rgba(255, 255, 255, 0.22);
    box-shadow: 0 36px 88px -42px rgba(0, 0, 0, 0.9);
    transform: translateY(-2px);
  }

  .hero-copy::after {
    @apply absolute right-4 top-4 h-24 w-24 rounded-full content-[''];
    background: radial-gradient(circle, rgba(255, 133, 24, 0.32), transparent 68%);
    filter: blur(4px);
  }

  .hero-kicker-wrap {
    @apply flex justify-center;
  }

  .hero-kicker {
    @apply inline-flex items-center rounded-full border border-white/15 px-3 py-1.5 text-[0.6rem] font-semibold uppercase tracking-[0.18em] text-white/70 sm:px-4 sm:text-[0.68rem] sm:tracking-[0.22em];
    background: rgba(255, 255, 255, 0.06);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.04);
  }

  .title {
    @apply mt-4 text-center font-bold uppercase text-[var(--title-color)] drop-shadow-lg lg:mt-1;
    letter-spacing: 0.12em;
    font-family: var(--title-font);
  }

  .title-index {
    @apply mb-0 text-[2.65rem] leading-[0.95] sm:text-6xl sm:leading-[5rem] lg:mb-1 lg:text-8xl;
  }

  .title-normal {
    @apply mb-1 text-2xl sm:text-3xl lg:text-5xl;
  }

  .subtitle {
    @apply mt-3 text-center text-[0.98rem] leading-snug text-[var(--subtitle-color)] drop-shadow-md sm:mt-4 sm:text-lg lg:text-3xl;
    font-family: var(--subtitle-font);
  }

  .hero-badges {
    @apply mt-5 flex flex-wrap justify-center gap-2 sm:mt-6 sm:gap-3;
  }

  .hero-badge {
    @apply inline-flex items-center rounded-full border border-white/10 px-3 py-1.5 text-[0.72rem] font-medium leading-tight text-white/80 sm:px-3.5 sm:py-2 sm:text-sm;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.08), rgba(255, 133, 24, 0.12));
    box-shadow: 0 14px 28px -20px rgba(0, 0, 0, 0.75);
  }

  .waves {
    @apply absolute -bottom-[1px] h-[10vh] max-h-[9.375rem] min-h-[3.125rem] w-full;
    @apply md:h-[15vh];
  }

  .waves > .parallax use {
    @apply fill-[var(--background-color)];
    animation: wave 25s cubic-bezier(0.5, 0.5, 0.45, 0.5) infinite;
  }

  @keyframes wave {
    0% {
      transform: translate3d(-90px, 0, 0);
    }
    100% {
      transform: translate3d(85px, 0, 0);
    }
  }

  @keyframes banner-onload-animation {
    0% {
      opacity: 0;
      height: calc(var(--banner-height) + 4rem);
    }
    100% {
      opacity: 1;
      height: var(--banner-height);
    }
  }
</style>
