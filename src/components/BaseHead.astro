---
import RaptorsConfig from "../../raptors.config";
import GlobalStyles from "./GlobalStyles.astro";
import ScriptSetup from "./ScriptSetup.astro";

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const seoImage = new URL(
  RaptorsConfig.seoImage ?? "/site/icons/logo512.png",
  Astro.site,
);
const seoKeywords = RaptorsConfig.seoKeywords?.join(", ");
const seoLocation = RaptorsConfig.seoLocation ?? {
  city: "Morelia",
  region: "Michoacán",
  country: "México",
};
const seoSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SportsOrganization",
      "@id": `${RaptorsConfig.site}#organization`,
      name: RaptorsConfig.username,
      url: RaptorsConfig.site,
      description: RaptorsConfig.description,
      sport: ["Mountain biking", "Enduro", "Trail riding"],
      logo: seoImage.toString(),
      image: seoImage.toString(),
      sameAs: RaptorsConfig.socialLinks.map((item) => item.link),
      areaServed: {
        "@type": "Place",
        name: `${seoLocation.city}, ${seoLocation.region}, ${seoLocation.country}`,
      },
      address: {
        "@type": "PostalAddress",
        addressLocality: seoLocation.city,
        addressRegion: seoLocation.region,
        addressCountry: seoLocation.country,
      },
    },
    {
      "@type": "WebSite",
      "@id": `${RaptorsConfig.site}#website`,
      url: RaptorsConfig.site,
      name: RaptorsConfig.title,
      description: RaptorsConfig.description,
      inLanguage: RaptorsConfig.locale,
      publisher: {
        "@id": `${RaptorsConfig.site}#organization`,
      },
    },
  ],
};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href="/site/icons/favicon.png" type="image/png" />
<!--<link rel="icon" href="/site/icons/favicon.svg" type="image/svg+xml" /> -->
<meta name="generator" content={Astro.generator} />

<!-- Google tag (gtag.js) -->
<script
  is:inline
  async
  src="https://www.googletagmanager.com/gtag/js?id=G-Z45LGJXLLR"></script>
<script>
  const analyticsWindow = window as Window & { dataLayer?: unknown[] };
  const dataLayer = (analyticsWindow.dataLayer = analyticsWindow.dataLayer || []);
  const gtag = (...args: unknown[]) => dataLayer.push(args);
  gtag("js", new Date());
  gtag("config", "G-Z45LGJXLLR");
</script>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{RaptorsConfig.title}</title>
<meta name="title" content={RaptorsConfig.title} />
<meta name="description" content={RaptorsConfig.description} />
<meta name="keywords" content={seoKeywords} />
<meta name="robots" content="index, follow, max-image-preview:large" />
<meta name="author" content={RaptorsConfig.username} />
<meta name="language" content={RaptorsConfig.locale} />
<meta name="geo.region" content={`${seoLocation.country}-${seoLocation.region}`} />
<meta name="geo.placename" content={`${seoLocation.city}, ${seoLocation.region}`} />
<meta name="ICBM" content={`${seoLocation.city}, ${seoLocation.region}, ${seoLocation.country}`} />

<!-- Iconos -->
<link rel="icon" type="image/png" sizes="192x192" href="/site/icons/logo192.png" />
<link rel="icon" type="image/png" sizes="512x512" href="/site/icons/logo512.png" />
<link rel="apple-touch-icon" href="/site/icons/logo192.png" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={RaptorsConfig.title} />
<meta property="og:description" content={RaptorsConfig.description} />
<meta property="og:site_name" content={RaptorsConfig.username} />
<meta property="og:locale" content="es_MX" />
<meta property="og:image" content={seoImage} />
<meta property="og:image:alt" content={RaptorsConfig.title} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={RaptorsConfig.title} />
<meta property="twitter:description" content={RaptorsConfig.description} />
<meta property="twitter:image" content={seoImage} />
<meta property="twitter:image:alt" content={RaptorsConfig.title} />

<!-- RSS AutoDiscovery -->
<link
  rel="alternate"
  type="application/rss+xml"
  title={RaptorsConfig.title}
  href={new URL("rss.xml", Astro.site)}
/>

<!-- SiteMap -->
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.bunny.net" />
<link
  href="https://fonts.bunny.net/css?family=manrope:400,500,600,700,800|noto-sans-sc:400,500,700|rajdhani:500,600,700"
  rel="stylesheet"
/>

<script is:inline type="application/ld+json" set:html={JSON.stringify(seoSchema)} />

<GlobalStyles />
<ScriptSetup />
