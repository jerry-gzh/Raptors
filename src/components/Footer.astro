---
import { Icon } from "astro-icon/components";
import RaptorsConfig from "../../raptors.config";
import TeamLogoFlip from "./widgets/TeamLogoFlip.astro";
---

<div class="mx-3 space-y-4">
  <!-- Owner info card -->
  <div
    class="hover-lift rounded-[2rem] border border-[var(--border-color)] bg-[var(--card-color)] transition-all lg:hidden"
    style="box-shadow: 0 22px 48px -34px var(--shadow-color);"
  >
    <div class="flex flex-row md:flex-col md:pt-4">
      <a href="/about" class="relative h-40 w-[9.5rem] shrink-0 md:hidden">
        <TeamLogoFlip
          primarySrc={RaptorsConfig.avatarUrl}
          secondarySrc={RaptorsConfig.alternateAvatarUrl ?? RaptorsConfig.avatarUrl}
          alt={`Logotipo de ${RaptorsConfig.username}`}
          className="absolute inset-0 block h-40 w-[9.5rem] rounded-l-3xl"
          imageClass="rounded-l-3xl p-3"
          fit="contain"
        />
        <div
          class="absolute inset-0 rounded-l-3xl"
          style="background:
            radial-gradient(circle at 50% 18%, rgba(255, 133, 24, 0.16), transparent 34%),
            linear-gradient(90deg, rgba(10, 10, 10, 0.04), rgba(10, 10, 10, 0.16));"
        >
        </div>
      </a>
      <a
        class="mx-auto hidden h-40 w-40 cursor-pointer rounded-3xl transition-all hover:brightness-75 md:block"
        href="/about"
      >
        <TeamLogoFlip
          primarySrc={RaptorsConfig.avatarUrl}
          secondarySrc={RaptorsConfig.alternateAvatarUrl ?? RaptorsConfig.avatarUrl}
          alt={`Logotipo de ${RaptorsConfig.username}`}
          className="block h-40 w-40 rounded-3xl"
          imageClass="rounded-3xl"
        />
      </a>
      <div class="flex min-w-0 grow flex-col justify-center space-y-3 px-4 py-3">
        <div class="flex flex-col items-start">
          <a
            href="/about"
            class="line-clamp-1 text-lg font-semibold text-[var(--text-color)]"
          >
            {RaptorsConfig.username}
          </a>
          <span class="mb-2 mt-1 h-1 w-8 rounded-full bg-[var(--primary-color)]"
          ></span>
          <p class="line-clamp-2 text-sm leading-snug text-[var(--text-color-lighten)]">
            {RaptorsConfig.sign}
          </p>
        </div>
        <ul class="grid w-full max-w-[10.5rem] grid-cols-3 gap-2">
          {
            RaptorsConfig.socialLinks.map((item) => (
              <li>
                <a
                  href={item.link}
                  class="flex h-9 w-9 items-center justify-center rounded-2xl border border-[var(--border-color)] text-[var(--primary-color)] transition-all hover:bg-[var(--primary-color-hover)]"
                >
                  <Icon name={item.icon} size={20} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

