---
import { getCollection } from "astro:content";
import { IdToSlug } from "../../utils/hash";
import PostLayout from "../../layouts/PostLayout.astro";
import { render } from "astro:content";
import { GetCoverURLForUnspecifiedEntry } from "../../utils/cover";
import { GetCanonicalSlugSource } from "../../utils/hash";
import SponsorsShowcase from "../../components/sections/SponsorsShowcase.astro";
import { GetAniversario26Sponsors } from "../../utils/sponsors";

export async function getStaticPaths() {
  const postEntries = await getCollection("posts");
  return postEntries.map((entry) => ({
    params: { slug: IdToSlug(entry.id) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const postCover = entry.data.cover ?? GetCoverURLForUnspecifiedEntry(entry.id);
const isAniversario26Post = GetCanonicalSlugSource(entry.id).toLowerCase() === "aniversario26";
const aniversario26Sponsors = isAniversario26Post ? GetAniversario26Sponsors() : [];
---

{
  !entry.data.licenseName && (
    <PostLayout
      title={entry.data.title}
      subTitle={entry.data.description}
      bannerImage={postCover}
      published={entry.data.published}
    >
      <div
        class="hidden"
        data-pagefind-body
        data-pagefind-weight="10"
        data-pagefind-meta="title"
      >
        {entry.data.title}
      </div>
      <div data-pagefind-body>
        <Content />
        {isAniversario26Post && <SponsorsShowcase sponsors={aniversario26Sponsors} />}
      </div>
    </PostLayout>
  )
}
{
  entry.data.licenseName && (
    <PostLayout
      title={entry.data.title}
      subTitle={entry.data.description}
      bannerImage={postCover}
      published={entry.data.published}
      license={{ name: entry.data.licenseName, url: entry.data.licenseUrl }}
      author={entry.data.author}
      sourceLink={entry.data.sourceLink}
    >
      <div
        class="hidden"
        data-pagefind-body
        data-pagefind-weight="10"
        data-pagefind-meta="title"
      >
        {entry.data.title}
      </div>
      <div data-pagefind-body>
        <Content />
        {isAniversario26Post && <SponsorsShowcase sponsors={aniversario26Sponsors} />}
      </div>
    </PostLayout>
  )
}
