---
import "../styles/animations.css";
import "../styles/scrollbar.css";
import "../styles/transitions.css";
import "../styles/searchbar.css";
import "overlayscrollbars/overlayscrollbars.css";
---

<style is:global>
  :root {
    --hue: 48;

    --primary-color: oklch(70% 0.19 var(--hue));
    --primary-color-lighten: oklch(95% 0.012 var(--hue));
    --primary-color-hover: oklch(88% 0.028 var(--hue));
    --primary-color-transparent: oklch(70% 0.15 var(--hue) / 14%);
    --text-color: oklch(21% 0.01 30);
    --text-color-lighten: oklch(44% 0.008 30);
    --card-color: oklch(98% 0.002 95);
    --card-color-lighten: oklch(95% 0.004 95);
    --card-color-transparent: oklch(99% 0.002 95 / 82%);
    --background-color: oklch(92% 0.004 95);
    --background-color-elevated: oklch(96% 0.003 95);
    --border-color: oklch(18% 0.01 30 / 24%);
    --shadow-color: oklch(12% 0.01 30 / 14%);
    --glow-strong: oklch(72% 0.16 var(--hue) / 20%);
    --glow-soft: oklch(70% 0.11 var(--hue) / 10%);
    --glow-base: oklch(68% 0.08 var(--hue) / 6%);

    --brand-font: "Rajdhani", "Manrope", sans-serif;
    --primary-font: "Manrope", "Noto Sans SC", sans-serif;
    --code-font: "JetBrains Mono", "Fira Code", monospace;

    --page-width-lg: 992px;
    --page-width-xl: 1264px;

    --banner-height: 55vh;
    --title-font: var(--brand-font);
    --title-color: oklch(100% 0 0 / 95%);
    --subtitle-font: var(--brand-font);
    --subtitle-color: oklch(100% 0 0 / 85%);

    --onload-animation-delay: 100ms;
    --onload-animation-interval: 100ms;
  }

  :root.dark {
    --primary-color: oklch(76% 0.18 var(--hue));
    --primary-color-lighten: oklch(21% 0.03 var(--hue));
    --primary-color-hover: oklch(16% 0.025 var(--hue));
    --primary-color-transparent: oklch(74% 0.16 var(--hue) / 22%);
    --text-color: oklch(95% 0.004 40);
    --text-color-lighten: oklch(76% 0.008 40);
    --card-color: oklch(16% 0.012 40);
    --card-color-lighten: oklch(21% 0.018 40);
    --card-color-transparent: oklch(11% 0.01 40 / 78%);
    --background-color: oklch(8% 0.01 40);
    --background-color-elevated: oklch(11% 0.012 40);
    --border-color: oklch(54% 0.04 var(--hue) / 34%);
    --shadow-color: oklch(0% 0 0 / 40%);
    --glow-strong: oklch(74% 0.22 var(--hue) / 24%);
    --glow-soft: oklch(70% 0.16 var(--hue) / 18%);
    --glow-base: oklch(72% 0.14 var(--hue) / 10%);
    color-scheme: dark;
  }

  html {
    background: var(--background-color);
  }

  body {
    min-height: 100vh;
    color: var(--text-color);
    background:
      radial-gradient(circle at 50% -10%, var(--glow-strong) 0, transparent 38%),
      radial-gradient(circle at 88% 10%, var(--glow-soft) 0, transparent 24%),
      radial-gradient(circle at 12% 82%, var(--glow-base) 0, transparent 26%),
      linear-gradient(
        135deg,
        color-mix(in oklab, var(--background-color-elevated) 94%, var(--primary-color) 6%) 0%,
        var(--background-color) 34%,
        color-mix(in oklab, var(--background-color) 96%, var(--primary-color) 4%) 100%
      ),
      linear-gradient(
        180deg,
        var(--background-color-elevated) 0%,
        var(--background-color) 24%,
        var(--background-color) 100%
      );
    background-attachment: fixed;
  }

  body::before {
    position: fixed;
    inset: 0;
    pointer-events: none;
    content: "";
    background-image:
      linear-gradient(
        135deg,
        transparent 0%,
        transparent 47%,
        var(--border-color) 50%,
        transparent 53%,
        transparent 100%
      );
    background-size: 24px 24px;
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.1), transparent 70%);
    opacity: 0.16;
  }

  body::after {
    position: fixed;
    inset: 0;
    pointer-events: none;
    content: "";
    background:
      radial-gradient(
        18% 46% at 12% 14%,
        oklch(79% 0.2 var(--hue) / 0.18) 0%,
        transparent 76%
      ),
      radial-gradient(
        10% 30% at 15% 10%,
        oklch(75% 0.21 var(--hue) / 0.16) 0%,
        transparent 78%
      ),
      radial-gradient(
        14% 34% at 18% 30%,
        oklch(76% 0.18 var(--hue) / 0.11) 0%,
        transparent 76%
      ),
      radial-gradient(
        20% 54% at 88% 16%,
        oklch(78% 0.17 var(--hue) / 0.16) 0%,
        transparent 74%
      ),
      radial-gradient(
        10% 28% at 84% 11%,
        oklch(74% 0.19 var(--hue) / 0.14) 0%,
        transparent 76%
      ),
      radial-gradient(
        15% 42% at 9% 74%,
        oklch(75% 0.17 var(--hue) / 0.11) 0%,
        transparent 76%
      ),
      radial-gradient(
        18% 50% at 86% 70%,
        oklch(74% 0.18 var(--hue) / 0.11) 0%,
        transparent 76%
      ),
      radial-gradient(
        12% 34% at 52% 88%,
        oklch(72% 0.16 var(--hue) / 0.08) 0%,
        transparent 74%
      ),
      conic-gradient(
        from 205deg at 13% 18%,
        transparent 0deg,
        oklch(80% 0.16 var(--hue) / 0.07) 40deg,
        transparent 110deg
      ),
      conic-gradient(
        from 150deg at 87% 18%,
        transparent 0deg,
        oklch(79% 0.15 var(--hue) / 0.06) 42deg,
        transparent 112deg
      );
    background-repeat: no-repeat;
    background-size:
      24% 52%,
      12% 32%,
      16% 38%,
      26% 58%,
      12% 30%,
      18% 46%,
      20% 52%,
      14% 36%,
      20% 34%,
      20% 34%;
    filter: blur(20px);
    opacity: 1;
    mix-blend-mode: normal;
    animation: ambient-flames 22s ease-in-out infinite alternate;
    transform-origin: center;
  }

  :root.dark body::after {
    display: none;
  }

  @keyframes ambient-flames {
    0% {
      transform: translate3d(0, 0, 0) scale(1);
      background-position:
        1% 0%,
        8% 2%,
        15% 18%,
        100% 0%,
        89% 3%,
        2% 86%,
        97% 78%,
        51% 94%,
        3% 6%,
        96% 8%;
    }

    50% {
      transform: translate3d(0, -0.5%, 0) scale(1.02);
      background-position:
        2% -2%,
        9% 0%,
        16% 15%,
        98% -1%,
        86% 1%,
        3% 82%,
        95% 74%,
        49% 90%,
        5% 4%,
        94% 5%;
    }

    100% {
      transform: translate3d(0, 0.35%, 0) scale(1.03);
      background-position:
        4% -1%,
        11% 1%,
        18% 13%,
        96% 1%,
        84% 0%,
        5% 79%,
        92% 70%,
        47% 87%,
        6% 2%,
        92% 3%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    body::after {
      animation: none;
    }
  }

  ::selection {
    color: oklch(14% 0.015 30);
    background: var(--primary-color);
  }

  .swup-progress-bar {
    height: 5px;
    background-color: var(--primary-color);
  }
</style>
