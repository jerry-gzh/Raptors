---
import { Icon } from "astro-icon/components";

export interface Props {
  name: string;
  link: string;
}
const { name, link } = Astro.props;
---

<a href={link} target="_blank">
  <div
    class="hover-lift flex h-11 w-11 flex-col justify-center rounded-2xl border border-[var(--border-color)] transition-all"
    style="background: color-mix(in oklab, var(--card-color) 84%, var(--primary-color) 16%); box-shadow: 0 14px 24px -20px var(--shadow-color);"
  >
    <div class="flex flex-row justify-center">
      <Icon name={name} size={24} class="text-[var(--primary-color)]" />
    </div>
  </div>
</a>
