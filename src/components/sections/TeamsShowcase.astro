---
import type { TeamEntry } from "../../utils/teams";

interface Props {
  teams: TeamEntry[];
}

const { teams } = Astro.props;
---

{
  teams.length > 0 && (
    <section class="not-prose teams-showcase" aria-labelledby="teams-heading">
      <div class="teams-intro">
        <span class="teams-kicker">Equipos invitados</span>
        <h2 id="teams-heading">Bienvenidos todos los equipos</h2>
        <p>
          Nos alegra recibir a cada grupo, comunidad y manada que se suma a este aniversario. Su presencia
          hace que la rodada crezca, conecte más territorios y se viva con una energía todavía más especial.
        </p>
      </div>

      <div class="teams-grid">
        {teams.map((team) => (
          <article class="team-card" aria-label={team.name} title={team.name}>
            <div class="team-logo-wrap">
              <img src={team.imageUrl} alt={team.name} class="team-logo" loading="lazy" />
            </div>
          </article>
        ))}
      </div>
    </section>
  )
}

<style>
  .teams-showcase {
    margin-top: 2.5rem;
    padding: 1.35rem;
    border-radius: 2rem;
    border: 1px solid color-mix(in srgb, var(--border-color) 74%, #ff7a1a 26%);
    background:
      radial-gradient(circle at top left, rgba(255, 125, 36, 0.12), transparent 28%),
      radial-gradient(circle at bottom right, rgba(255, 140, 48, 0.1), transparent 24%),
      linear-gradient(180deg, color-mix(in srgb, var(--card-color) 93%, #140b08 7%) 0%, var(--card-color) 100%);
    box-shadow:
      0 26px 55px -40px var(--shadow-color),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }

  .teams-intro {
    margin-bottom: 1.35rem;
  }

  .teams-kicker {
    display: inline-flex;
    margin-bottom: 0.7rem;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 138, 51, 0.24);
    background: rgba(255, 123, 32, 0.07);
    color: var(--primary-color);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .teams-intro h2 {
    margin: 0;
    display: block;
    color: var(--text-color);
    font-size: clamp(1.35rem, 2.2vw, 1.9rem);
    line-height: 1.08;
    text-wrap: balance;
  }

  .teams-intro h2::before {
    content: none;
  }

  .teams-intro p {
    max-width: 42rem;
    margin: 0.85rem 0 0;
    color: var(--text-color-secondary);
    line-height: 1.7;
    text-align: justify;
  }

  .teams-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .team-card {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 10.25rem;
    padding: 0.55rem;
    border-radius: 1.35rem;
    border: 1px solid color-mix(in srgb, var(--border-color) 78%, rgba(255, 132, 44, 0.3) 22%);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.03), transparent 45%),
      color-mix(in srgb, var(--card-color-lighten) 88%, #1a0f09 12%);
    overflow: hidden;
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease;
  }

  .team-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at top, rgba(255, 154, 75, 0.1), transparent 58%);
    opacity: 0.75;
    pointer-events: none;
  }

  .team-card:hover {
    transform: translateY(-3px);
    border-color: rgba(255, 145, 66, 0.42);
    box-shadow: 0 24px 38px -32px rgba(255, 122, 32, 0.32);
  }

  .team-logo-wrap {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 9.15rem;
    padding: 0.45rem;
    border-radius: 1rem;
    background:
      radial-gradient(circle at top, rgba(255, 255, 255, 0.14), transparent 44%),
      rgba(18, 12, 10, 0.36);
    backdrop-filter: blur(3px);
  }

  .team-logo {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 8.35rem;
    object-fit: contain;
    filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.18));
  }

  @media (min-width: 768px) {
    .teams-showcase {
      padding: 1.7rem;
    }

    .teams-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }
  }

  @media (min-width: 1024px) {
    .teams-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
