  <!-- Site footer -->
  <footer>
    <div
      class="divide-y divide-dashed py-4 lg:pt-0"
      style="border-color: transparent;"
    >
      <div class="border-[var(--border-color)]"></div>
      <div class="border-[var(--border-color)]"></div>
    </div>
    <div
      class="flex w-full flex-col items-center text-sm text-[var(--text-color-lighten)]"
    >
      <p class="footer-tagline">No es solo una rodada. Es la manada.</p>
      <p>
        © {new Date().getFullYear()}
        {RaptorsConfig.username} All Rights Reserved.
      </p>
      <p>
        Powered By <a
          class="link"
          href="https://www.instagram.com/jerry_gzh/profilecard/?igsh=MXN5bnkwaW4xNHZrMQ==">Jerry</a
        > & <a class="link" href="https://astro.build/">Astro</a>
      </p>
    </div>
  </footer>
</div>

<style>
  .footer-tagline {
    @apply mb-2 rounded-full border border-[var(--border-color)] px-4 py-1.5 text-[0.72rem] font-semibold uppercase tracking-[0.18em] text-[var(--primary-color)];
    background: color-mix(in oklab, var(--card-color) 86%, var(--primary-color) 14%);
  }

  .link {
    @apply text-[var(--primary-color)] transition-all hover:brightness-110;
  }

  .category {
    font-family: var(--primary-font);
  }

  .category:hover > p {
    @apply pl-2 text-[var(--primary-color)];
  }
</style>
