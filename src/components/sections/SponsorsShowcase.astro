---
import type { SponsorEntry } from "../../utils/sponsors";

interface Props {
  sponsors: SponsorEntry[];
}

const { sponsors } = Astro.props;

const principalSponsors = sponsors.filter((sponsor) => sponsor.tier === "principal");
const alliedSponsors = sponsors.filter((sponsor) => sponsor.tier !== "principal");
---

{
  sponsors.length > 0 && (
    <section class="not-prose sponsors-showcase" aria-labelledby="sponsors-heading">
      <div class="sponsors-intro">
        <span class="sponsors-kicker">Patrocinadores del 3er aniversario</span>
        <h2 id="sponsors-heading">  La rodada también se mueve gracias a quienes creen en ella</h2>
        <p>
          Cada marca, negocio y aliado que aparece aquí ayuda a que esta edición se viva con más fuerza,
          mejor logística y una comunidad todavía más unida.
        </p>
      </div>

      {
        principalSponsors.length > 0 && (
          <div class="sponsors-tier-block">
            <div class="tier-header">
              <span class="tier-chip">Impulso principal</span>
            </div>
            <div class="sponsors-grid sponsors-grid-featured">
              {principalSponsors.map((sponsor) => (
                <article class="sponsor-card sponsor-card-featured" aria-label={sponsor.name} title={sponsor.name}>
                  <div class="sponsor-logo-wrap">
                    <img src={sponsor.imageUrl} alt={sponsor.name} class="sponsor-logo" loading="lazy" />
                  </div>
                </article>
              ))}
            </div>
          </div>
        )
      }

      {
        alliedSponsors.length > 0 && (
          <div class="sponsors-tier-block">
            <div class="tier-header">
              <span class="tier-chip tier-chip-muted">Aliados del aniversario</span>
            </div>
            <div class="sponsors-grid">
              {alliedSponsors.map((sponsor) => (
                <article class="sponsor-card" aria-label={sponsor.name} title={sponsor.name}>
                  <div class="sponsor-logo-wrap">
                    <img src={sponsor.imageUrl} alt={sponsor.name} class="sponsor-logo" loading="lazy" />
                  </div>
                </article>
              ))}
            </div>
          </div>
        )
      }
    </section>
  )
}

<style>
  .sponsors-showcase {
    margin-top: 3.5rem;
    padding: 1.35rem;
    border-radius: 2rem;
    border: 1px solid color-mix(in srgb, var(--border-color) 72%, #ff7a1a 28%);
    background:
      radial-gradient(circle at top right, rgba(255, 125, 36, 0.16), transparent 26%),
      radial-gradient(circle at bottom left, rgba(255, 140, 48, 0.12), transparent 24%),
      linear-gradient(180deg, color-mix(in srgb, var(--card-color) 92%, #140b08 8%) 0%, var(--card-color) 100%);
    box-shadow:
      0 26px 55px -40px var(--shadow-color),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  .sponsors-intro {
    margin-bottom: 1.5rem;
  }

  .sponsors-kicker {
    display: inline-flex;
    margin-bottom: 0.7rem;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 138, 51, 0.28);
    background: rgba(255, 123, 32, 0.08);
    color: var(--primary-color);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .sponsors-intro h2 {
    margin: 0;
    display: block;
    color: var(--text-color);
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    line-height: 1.08;
    text-wrap: balance;
  }

  .sponsors-intro h2::before {
    content: none;
  }

  .sponsors-intro p {
    max-width: 42rem;
    margin: 0.85rem 0 0;
    color: var(--text-color-secondary);
    line-height: 1.7;
  }

  .sponsors-tier-block + .sponsors-tier-block {
    margin-top: 1.5rem;
  }

  .tier-header {
    margin-bottom: 0.9rem;
  }

  .tier-chip {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    background: linear-gradient(135deg, rgba(255, 122, 32, 0.22), rgba(255, 89, 20, 0.12));
    border: 1px solid rgba(255, 138, 51, 0.26);
    color: color-mix(in srgb, var(--text-color) 86%, #fff 14%);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .tier-chip-muted {
    background: linear-gradient(135deg, rgba(255, 122, 32, 0.14), rgba(255, 89, 20, 0.08));
  }

  .sponsors-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .sponsors-grid-featured {
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }

  .sponsor-card {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 10.25rem;
    padding: 0.55rem;
    border-radius: 1.35rem;
    border: 1px solid color-mix(in srgb, var(--border-color) 78%, rgba(255, 132, 44, 0.32) 22%);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.03), transparent 45%),
      color-mix(in srgb, var(--card-color-lighten) 88%, #1a0f09 12%);
    overflow: hidden;
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease;
  }

  .sponsor-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at top, rgba(255, 154, 75, 0.1), transparent 58%);
    opacity: 0.75;
    pointer-events: none;
  }

  .sponsor-card:hover {
    transform: translateY(-3px);
    border-color: rgba(255, 145, 66, 0.44);
    box-shadow: 0 24px 38px -32px rgba(255, 122, 32, 0.35);
  }

  .sponsor-card-featured {
    min-height: 11.6rem;
  }

  .sponsor-logo-wrap {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 9.15rem;
    padding: 0.45rem;
    border-radius: 1rem;
    background:
      radial-gradient(circle at top, rgba(255, 255, 255, 0.16), transparent 44%),
      rgba(18, 12, 10, 0.4);
    backdrop-filter: blur(3px);
  }

  .sponsor-card-featured .sponsor-logo-wrap {
    min-height: 10.5rem;
  }

  .sponsor-logo {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 8.35rem;
    object-fit: contain;
    filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.18));
  }

  .sponsor-card-featured .sponsor-logo {
    max-height: 9.5rem;
  }

  @media (min-width: 768px) {
    .sponsors-showcase {
      padding: 1.7rem;
    }

    .sponsors-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }
  }

  @media (min-width: 1024px) {
    .sponsors-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
